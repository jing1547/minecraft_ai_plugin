{
  "name": "minecraft-ai-body",
  "version": "1.0.0-alpha.1",
  "description": "Node.js Mineflayer bot component for Minecraft AI hybrid architecture - handles game world interactions and movement",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "watch": "tsc --watch",
    "clean": "rimraf dist",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix"
  },
  "keywords": [
    "minecraft",
    "mineflayer",
    "bot",
    "ai",
    "websocket",
    "automation"
  ],
  "author": "MinecraftAI Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/minecraft-ai/minecraft-ai-body"
  },
  "dependencies": {
    "mineflayer": "^4.30.0",
    "mineflayer-builder": "^1.0.1",
    "mineflayer-pathfinder": "^2.4.5",
    "mineflayer-pvp": "^1.3.2",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.13",
    "@types/ws": "^8.18.1",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^4.9.5"
  }
}
